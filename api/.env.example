# Copy to .env and fill in. Never commit the real .env.

# "production" enforces HTTPS and requires APP_PEPPER.
APP_ENV=production
APP_BASE_PATH=

# Secret mixed into every password hash. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Changing this invalidates all existing passwords, so set it once, before launch.
APP_PEPPER=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goldenacres
DB_USER=goldenacres
DB_PASSWORD=
# DB_SOCKET=/tmp/mysql.sock
DB_SSL=false
# DB_SSL_CA=/etc/ssl/certs/mysql-ca.pem

# Token lifetimes, in seconds.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Argon2id cost. Raise memory first; 64 MiB is a reasonable server default.
ARGON_MEMORY_KIB=65536
ARGON_TIME_COST=3
ARGON_THREADS=2

# Abuse limits.
RL_LOGIN_PER_IP=20
RL_LOGIN_PER_EMAIL=10
RL_REGISTER_PER_HOUR=5
RL_REFRESH_PER_HOUR=120
RL_API_PER_MINUTE=300

MAX_BODY_BYTES=1048576

# Only enable behind a proxy you control, otherwise X-Forwarded-For is spoofable.
TRUST_PROXY=false

# Comma-separated browser origins. Leave empty for a native-only client.
CORS_ORIGINS=
